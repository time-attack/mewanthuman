<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Optional runtime config for PhoneContextHook.
  Copy to: /var/mobile/Library/Preferences/com.yourname.phonecontexthook.plist
  The tweak reads this on load (before any UI appears).
-->
<plist version="1.0">
<dict>
    <key>APIEndpoint</key>
    <string>https://your-api.example.com/phone</string>
</dict>
</plist>
