{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "20",
    "python": "3.13"
  },
  "steps": {
    "install": {
      "commands": [
        "npm install",
        "python3 -m venv .venv",
        ".venv/bin/pip install browser-use-sdk"
      ]
    }
  },
  "deploy": {
    "startCommand": "node server.js"
  }
}
